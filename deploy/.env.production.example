# 复制为 deploy/.env.production 后填写。该真实文件已被 .gitignore 忽略。
SMART_TRANSIT_DB_PASSWORD=replace-with-a-long-random-password

# 浏览器实际访问站点的 Origin，不带结尾斜杠。
TRANSIT_WEBSOCKET_ALLOWED_ORIGIN=https://transit.example.com

# 本地演练可改为 39081；ECS 正式 HTTP 部署保持 80。
SMART_TRANSIT_HTTP_PORT=80
SMART_TRANSIT_IMAGE_TAG=1.0.0-demo

# 2 GiB 演示环境历史策略。
TRANSIT_HISTORY_SAMPLE_INTERVAL_SECONDS=5
TRANSIT_HISTORY_RETENTION_MINUTES=30
TRANSIT_HISTORY_CLEANUP_INTERVAL_MINUTES=30
TRANSIT_HISTORY_ENABLED=true

# 每条有效仿真线路的车辆数，304 条线路时合计约 912 辆。
TRANSIT_SIMULATION_DEFAULTS_VEHICLE_COUNT=3
TRANSIT_SIMULATION_ENABLED=true
