<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.jygis.smarttransit.mapper.StopMapper">

    <select id="findAll"
            resultType="com.jygis.smarttransit.pojo.Stop">
        SELECT
            stop_id,
            stop_name,
            longitude,
            latitude
        FROM public.stops
        ORDER BY stop_id
    </select>

</mapper>
